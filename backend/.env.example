# Puerto del backend
PORT=5000

# Entorno
NODE_ENV=development

# URL de conexión a MySQL (ajusta usuario, password y nombre de BD)
DATABASE_URL="mysql://root:password@localhost:3306/project_manager"

# JWT
JWT_SECRET="super_secret_jwt_key_cambialo"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Bcrypt
BCRYPT_SALT_ROUNDS=10
